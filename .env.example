
# Refresh token OAuth YouTube (lấy từ log Lavalink lần đăng nhập đầu, dùng tài khoản phụ)
YOUTUBE_REFRESH_TOKEN=

# Webhook Discord nhận cảnh báo khi Lavalink mất kết nối (tuỳ chọn)
ALERT_WEBHOOK_URL=

# Múi giờ cho thống kê và Wrapped
TIMEZONE=Asia/Ho_Chi_Minh
# Tra lời bài hát online từ LRCLIB khi file không có lời (on/off)
LYRICS_LOOKUP=on
