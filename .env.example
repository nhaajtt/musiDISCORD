
# Refresh token OAuth YouTube (lấy từ log Lavalink lần đăng nhập đầu, dùng tài khoản phụ)
YOUTUBE_REFRESH_TOKEN=

# Webhook Discord nhận cảnh báo khi Lavalink mất kết nối (tuỳ chọn)
ALERT_WEBHOOK_URL=

# Múi giờ cho thống kê và Wrapped
TIMEZONE=Asia/Ho_Chi_Minh
# Tra lời bài hát online từ LRCLIB khi file không có lời (on/off)
LYRICS_LOOKUP=on

# Chu kỳ tự lưu hàng chờ (giây). Đặt 0 trên Raspberry Pi để giảm ghi đĩa (vẫn lưu khi bắt đầu bài mới và khi tắt bot)
AUTOSAVE_SECONDS=15

# Đóng góp nhạc: thành viên gửi file của họ, chủ bot duyệt (on/off, mặc định off)
CONTRIBUTIONS=off
# Dung lượng tối đa mỗi file đóng góp, tính bằng MB
CONTRIB_MAX_MB=30
# ID người được duyệt đóng góp, cách nhau bởi dấu phẩy (để trống = chủ bot lấy từ Discord)
OWNER_IDS=

# --- Pi 5 / mở rộng (tắt mặc định) ---
# Tên bot (hiện trong cảnh báo và trang trạng thái)
BOT_NAME=musiDISCORD
# Tự gắn thẻ cho bài thiếu thẻ bằng dấu vân âm thanh (AcoustID + MusicBrainz). Lấy khoá miễn phí ở https://acoustid.org/new-application
AUTOTAG=off
ACOUSTID_KEY=
# Phân tích nhịp độ, năng lượng, độ sáng cho /vibe và /similar (dùng ffmpeg, chạy nền, khá tốn CPU lần đầu)
ANALYSIS=off
# Trang trạng thái /display và API cho màn hình nhỏ (0 hoặc để trống = tắt). Docker chỉ mở cổng này trên máy chạy bot
DISPLAY_PORT=
# Bắt buộc nếu muốn điều khiển (tạm dừng, bỏ qua, âm lượng) từ trang /display hoặc màn hình TFT; chuỗi ngẫu nhiên dài
DISPLAY_TOKEN=
# Đẩy bản sao lưu lên cloud bằng rclone sau khi sao lưu (ví dụ gdrive:musidiscord), để trống nếu không dùng
BACKUP_RCLONE_REMOTE=
# Số bản sao lưu giữ lại
BACKUP_KEEP=14
