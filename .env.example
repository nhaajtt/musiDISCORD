# Discord bot token (Developer Portal > your application > Bot > Reset Token). Required
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information). Required
CLIENT_ID=
# Optional: a server ID to register slash commands in just that server (they appear instantly; leave empty for global commands)
GUILD_ID=

# Password shared by the bot and Lavalink. Change it from the default
LAVALINK_PASSWORD=youshallnotpass

# Spotify app credentials, only needed for Spotify links (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube OAuth refresh token (taken from the Lavalink log on first login; use a secondary account)
YOUTUBE_REFRESH_TOKEN=

# Discord webhook that receives alerts when Lavalink loses its connection (optional)
ALERT_WEBHOOK_URL=

# Time zone for stats and Wrapped
TIMEZONE=Asia/Ho_Chi_Minh
# Look up lyrics online from LRCLIB when the file has none (on/off)
LYRICS_LOOKUP=on

# Queue autosave interval (seconds). Set 0 on a Raspberry Pi to reduce disk writes (it still saves when a new track starts and when the bot shuts down)
AUTOSAVE_SECONDS=15

# Music contributions: members upload their own files and the bot owner reviews them (on/off, default off)
CONTRIBUTIONS=off
# Maximum size of each contributed file, in MB
CONTRIB_MAX_MB=30
# IDs of people allowed to review contributions, comma-separated (empty = the bot owner as reported by Discord)
OWNER_IDS=

# --- Pi 5 / extras (off by default) ---
# Bot name (shown in alerts and on the status page)
BOT_NAME=musiDISCORD
# Auto-tag tracks missing tags using audio fingerprints (AcoustID + MusicBrainz). Get a free key at https://acoustid.org/new-application
AUTOTAG=off
ACOUSTID_KEY=
# Analyze tempo, energy and brightness for /vibe and /similar (uses ffmpeg, runs in the background, fairly CPU-heavy the first time)
ANALYSIS=off
# /display status page and API for the small screen (0 or empty = off). Docker only exposes this port on the machine running the bot
DISPLAY_PORT=
# Required if you want to control playback (pause, skip, volume) from the /display page or the TFT screen; a long random string
DISPLAY_TOKEN=
# Upload backups to the cloud with rclone after backing up (e.g. gdrive:musidiscord); leave empty to disable
BACKUP_RCLONE_REMOTE=
# Number of backups to keep
BACKUP_KEEP=14
