# Sao chep thanh pi/display.env (systemd doc file nay)
DISPLAY_URL=http://127.0.0.1:8787
# Trung voi DISPLAY_TOKEN trong .env cua bot (bat buoc neu muon bam nut dieu khien tren man hinh)
DISPLAY_TOKEN=
# Framebuffer cua man hinh TFT (thuong la fb1 khi HDMI la fb0)
FB_DEVICE=/dev/fb1
# Cam ung: de trong de tu tim ADS7846/XPT2046. Lech truc thi doi 3 co duoi day (0/1)
TOUCH_DEVICE=
TOUCH_SWAP=0
TOUCH_INVERT_X=0
TOUCH_INVERT_Y=0
# Hiệu chỉnh từng trục (bật TOUCH_DEBUG=1 rồi chạm bốn góc để xem giá trị raw; để trống = đọc từ thiết bị)
TOUCH_X_MIN=
TOUCH_X_MAX=
TOUCH_Y_MIN=
TOUCH_Y_MAX=
# Ảnh đại diện hiện ở góc trên phải màn TFT: đặt file ảnh tại pi/avatar.jpg (không đưa lên git). Tuỳ chọn cắt: x0,y0,x1,y1 trên ảnh gốc
AVATAR_CROP=
AVATAR_W=200
AVATAR_H=190
AVATAR_RADIUS=10
