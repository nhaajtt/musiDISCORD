# Copy to pi/display.env (systemd reads this file)
DISPLAY_URL=http://127.0.0.1:8787
# Must match DISPLAY_TOKEN in the bot's .env (required for the on-screen control buttons)
DISPLAY_TOKEN=
# Framebuffer of the TFT screen (usually fb1 when HDMI is fb0)
FB_DEVICE=/dev/fb1
# Touch: leave empty to auto-detect ADS7846/XPT2046. If the axes are off, change the 3 flags below (0/1)
TOUCH_DEVICE=
TOUCH_SWAP=0
TOUCH_INVERT_X=0
TOUCH_INVERT_Y=0
# Per-axis calibration (set TOUCH_DEBUG=1 and tap the four corners to see the raw values; empty = read from the device)
TOUCH_X_MIN=
TOUCH_X_MAX=
TOUCH_Y_MIN=
TOUCH_Y_MAX=
# Avatar shown in the top-right corner of the TFT screen: put the image at pi/avatar.jpg (not committed to git). Optional crop: x0,y0,x1,y1 on the source image
AVATAR_CROP=
AVATAR_W=228
AVATAR_H=226
AVATAR_RADIUS=0
